{
  "name": "websps-mcp",
  "version": "0.1.0",
  "description": "MCP server for Web@SPS PLC devices",
  "license": "MIT",
  "author": "Wolfgang Brangl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbrangl/websps-mcp.git"
  },
  "homepage": "https://github.com/wbrangl/websps-mcp#readme",
  "bugs": {
    "url": "https://github.com/wbrangl/websps-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web@sps",
    "plc",
    "sps"
  ],
  "type": "module",
  "bin": {
    "websps-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
